# Server Environment Configuration Template
PORT=5000
NODE_ENV=development

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=succeed_crm
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/succeed_crm

# Uploads Configuration
EXPOSE_UPLOADS_PUBLIC=true

# Payment & External Gateway Integration Secrets
CREGIS_API_SECRET=your_cregis_secret_key
JEXIPAY_SECRET_KEY=your_jexipay_secret_key
SHUFTI_CLIENT_SECRET=your_shufti_secret_key

# MT5 SignalR Bridge Server URL
MT5_BRIDGE_URL=http://localhost:8080/hubs/trading
